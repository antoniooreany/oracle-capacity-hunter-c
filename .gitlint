# Standard Gitlint configuration generated by gitlint-sync
[general]
ignore=title-trailing-punctuation, T3
verbosity=2

[title-max-length]
line-length=72

[title-format]
regex=^(feat|fix|docs|refactor|test|chore)(\([\w\-]+\))?!?: .*$
error-msg=Commit title must follow Conventional Commits format, e.g., 'feat(ui): add button'
